<Window x:Class="CodexBalanceWidget.App.Windows.AvatarCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBalanceWidget.App.Windows"
        Title="裁剪头像"
        Width="336"
        Height="472"
        MinWidth="296"
        MaxWidth="352"
        MinHeight="430"
        MaxHeight="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}"
        KeyDown="OnWindowKeyDown">
    <Window.Resources>
        <Style x:Key="CropButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value=".7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value=".42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="16"
            MouseLeftButtonDown="OnTitleAreaMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              ShadowDepth="4"
                              Color="#9A000000"
                              Opacity=".52"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="68"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="裁剪头像"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="15"
                           FontWeight="SemiBold"/>
                <TextBlock Text="拖动图片定位，滚轮或滑块缩放"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           FontSize="9"
                           Margin="0,2,0,0"/>
            </StackPanel>

            <local:AvatarCropViewport x:Name="CropViewport"
                                      Grid.Row="1"
                                      Width="{Binding ElementName=CropSizeSlider, Path=Value}"
                                      Height="{Binding ElementName=CropSizeSlider, Path=Value}"
                                      MinWidth="176"
                                      MinHeight="176"
                                      MaxWidth="232"
                                      MaxHeight="232"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Accent="{DynamicResource AccentBrush}"
                                      Track="{DynamicResource DividerBrush}"
                                      ParametersChanged="OnCropParametersChanged"/>

            <Grid Grid.Row="2" Margin="3,5,3,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="缩放"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider"
                        Grid.Column="1"
                        Minimum="1"
                        Maximum="8"
                        Value="1"
                        Margin="10,0"
                        ValueChanged="OnZoomSliderValueChanged"/>
                <TextBlock x:Name="ZoomValueText"
                           Grid.Column="2"
                           Text="1.0×"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1"
                           Text="裁剪框"
                           Foreground="{DynamicResource MutedTextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
                <Slider x:Name="CropSizeSlider"
                        Grid.Row="1"
                        Grid.Column="1"
                        Minimum="176"
                        Maximum="232"
                        Value="232"
                        Margin="10,0"/>
                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="{Binding ElementName=CropSizeSlider, Path=Value, StringFormat={}{0:0} px}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="3" Margin="3,3,3,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="WindowAvatarPreview"
                             Width="32"
                             Height="32"
                             Stroke="{DynamicResource DividerBrush}"
                             StrokeThickness="1"/>
                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="窗口"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="9.5"/>
                        <TextBlock Text="32 px"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="8"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="BubbleAvatarPreview"
                             Width="48"
                             Height="48"
                             Stroke="{DynamicResource AccentBrush}"
                             StrokeThickness="2"/>
                    <StackPanel Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="气泡"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="9.5"/>
                        <TextBlock Text="48 px"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="8"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Grid.Row="4"
                       Foreground="{DynamicResource WarningBrush}"
                       FontSize="9"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Content="重新选择…"
                        HorizontalAlignment="Left"
                        Style="{StaticResource CropButtonStyle}"
                        Margin="0"
                        Click="OnReselectClick"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="取消"
                            Style="{StaticResource CropButtonStyle}"
                            IsCancel="True"
                            Click="OnCancelClick"/>
                    <Button x:Name="UseAvatarButton"
                            Content="使用头像"
                            Foreground="White"
                            Background="{DynamicResource AccentBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Style="{StaticResource CropButtonStyle}"
                            IsDefault="True"
                            Click="OnUseAvatarClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
