<Window x:Class="CodexBalanceWidget.App.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexBalanceWidget.App.Controls"
        Title="Codex 额度"
        Width="300"
        Height="320"
        MinWidth="240"
        MaxWidth="300"
        MinHeight="148"
        MaxHeight="320"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        Focusable="False"
        FontFamily="{StaticResource UiFont}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        PreviewMouseWheel="OnPreviewMouseWheel"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        PreviewMouseDown="OnWindowPreviewMouseDown"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="FiveHourBrush" Color="#FF9D91FF"/>

        <Style x:Key="FlatButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource CardHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value=".72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CreditCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Padding" Value="9,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ExpiryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CreditTemplate">
            <Border Style="{StaticResource CreditCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   FontSize="8.5"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ExpiryText}"
                               Style="{StaticResource ExpiryTextStyle}"
                               Margin="6,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainPanel"
                Margin="5"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="11,10,11,9">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14"
                                  Direction="270"
                                  ShadowDepth="3"
                                  Color="#9A000000"
                                  Opacity=".48"/>
            </Border.Effect>

            <Grid x:Name="ExpandedShell">
                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>

                <Grid x:Name="ExpandedDragHandle"
                      Grid.Row="0"
                      Background="Transparent"
                      Cursor="SizeAll"
                      ToolTip="拖动可小范围调整位置"
                      PreviewMouseLeftButtonDown="OnExpandedDragMouseDown"
                      PreviewMouseLeftButtonUp="OnExpandedDragMouseUp"
                      PreviewMouseMove="OnExpandedDragMouseMove"
                      LostMouseCapture="OnExpandedDragLostCapture">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="ExpandedAvatarHost"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Background="{DynamicResource CardBrush}"
                            Margin="0,0,8,0">
                        <Grid>
                            <Image x:Name="ExpandedAvatarImage" Stretch="UniformToFill"/>
                            <TextBlock x:Name="ExpandedAvatarFallback"
                                       Text="&#xE77B;"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="Codex 额度"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               FontSize="12"
                               VerticalAlignment="Center"/>
                    <Grid Grid.Column="2"
                          VerticalAlignment="Center">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{Binding StatusBrush}"
                                 ToolTip="{Binding StatusText}"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid x:Name="VerticalLayout">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="22"/>
                            <RowDefinition Height="108"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:AdaptiveQuotaRing Grid.Column="0"
                                                     Margin="2"
                                                     Heading="周额度"
                                                     Detail="{Binding WeeklyDetail}"
                                                     RemainingPercent="{Binding WeeklyRemaining}"
                                                     Accent="{DynamicResource AccentBrush}"
                                                     Track="{DynamicResource DividerBrush}"
                                                     TextBrush="{DynamicResource TextBrush}"
                                                     MutedBrush="{DynamicResource SubtleTextBrush}"/>
                            <local:AdaptiveQuotaRing Grid.Column="1"
                                                     Margin="2"
                                                     Heading="5 小时"
                                                     Detail="{Binding FiveHourDetail}"
                                                     RemainingPercent="{Binding FiveHourRemaining}"
                                                     Accent="{StaticResource FiveHourBrush}"
                                                     Track="{DynamicResource DividerBrush}"
                                                     TextBrush="{DynamicResource TextBrush}"
                                                     MutedBrush="{DynamicResource SubtleTextBrush}"/>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="{Binding CardsSummary}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ScrollViewer x:Name="CreditScrollViewer"
                                      Grid.Row="2"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      PanningMode="VerticalOnly"
                                      ScrollChanged="OnCreditScrollChanged">
                            <ItemsControl ItemsSource="{Binding Credits}"
                                          ItemTemplate="{StaticResource CreditTemplate}"/>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="HorizontalLayout" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="122"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:AdaptiveQuotaRing Grid.Column="0"
                                                     Margin="1"
                                                     Heading="周"
                                                     RemainingPercent="{Binding WeeklyRemaining}"
                                                     Accent="{DynamicResource AccentBrush}"
                                                     Track="{DynamicResource DividerBrush}"
                                                     TextBrush="{DynamicResource TextBrush}"
                                                     MutedBrush="{DynamicResource SubtleTextBrush}"/>
                            <local:AdaptiveQuotaRing Grid.Column="1"
                                                     Margin="1"
                                                     Heading="5h"
                                                     RemainingPercent="{Binding FiveHourRemaining}"
                                                     Accent="{StaticResource FiveHourBrush}"
                                                     Track="{DynamicResource DividerBrush}"
                                                     TextBrush="{DynamicResource TextBrush}"
                                                     MutedBrush="{DynamicResource SubtleTextBrush}"/>
                        </Grid>
                        <Grid Grid.Column="1" Margin="7,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="21"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding CardsSummary}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="9.5"
                                       VerticalAlignment="Center"/>
                            <ScrollViewer x:Name="HorizontalCreditScrollViewer"
                                          Grid.Row="1"
                                          VerticalScrollBarVisibility="Hidden"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False"
                                          ScrollChanged="OnCreditScrollChanged">
                                <ItemsControl ItemsSource="{Binding Credits}"
                                              ItemTemplate="{StaticResource CreditTemplate}"/>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <Grid x:Name="MinimalLayout" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="78"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <local:AdaptiveQuotaRing Grid.Column="0"
                                                 Margin="1"
                                                 Heading="周"
                                                 RemainingPercent="{Binding WeeklyRemaining}"
                                                 Accent="{DynamicResource AccentBrush}"
                                                 Track="{DynamicResource DividerBrush}"
                                                 TextBrush="{DynamicResource TextBrush}"
                                                 MutedBrush="{DynamicResource SubtleTextBrush}"/>
                        <local:AdaptiveQuotaRing Grid.Column="1"
                                                 Margin="1"
                                                 Heading="5h"
                                                 RemainingPercent="{Binding FiveHourRemaining}"
                                                 Accent="{StaticResource FiveHourBrush}"
                                                 Track="{DynamicResource DividerBrush}"
                                                 TextBrush="{DynamicResource TextBrush}"
                                                 MutedBrush="{DynamicResource SubtleTextBrush}"/>
                        <StackPanel Grid.Column="2"
                                    Margin="5,5,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding CardsCompactSummary}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Canvas x:Name="QuickSliderLane"
                        Grid.RowSpan="3"
                        Width="12"
                        Margin="0,39,-8,4"
                        HorizontalAlignment="Right"
                        Background="Transparent">
                    <Border x:Name="QuickSlider"
                            Width="3"
                            Height="42"
                            Background="{DynamicResource MutedTextBrush}"
                            CornerRadius="5"
                            Opacity=".2"
                            Cursor="SizeNS"
                            MouseEnter="OnQuickSliderMouseEnter"
                            MouseLeave="OnQuickSliderMouseLeave"
                            PreviewMouseLeftButtonDown="OnQuickSliderMouseDown"
                            PreviewMouseLeftButtonUp="OnQuickSliderMouseUp"
                            PreviewMouseMove="OnQuickSliderMouseMove"/>
                </Canvas>
            </Grid>
        </Border>

        <Grid x:Name="SettingsHandle"
              Width="20"
              Height="20"
              Margin="0,0,6,6"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Cursor="Hand"
              MouseEnter="OnSettingsHandleMouseEnter"
              MouseLeave="OnSettingsAreaMouseLeave"
              PreviewMouseLeftButtonDown="OnSettingsHandleClick">
            <Polygon Points="5,13 15,13 15,3"
                     Fill="{DynamicResource MutedTextBrush}"
                     Opacity=".62"
                     RenderTransformOrigin=".5,.5">
                <Polygon.RenderTransform>
                    <RotateTransform x:Name="SettingsTriangleRotation" Angle="0"/>
                </Polygon.RenderTransform>
            </Polygon>
        </Grid>

        <Popup x:Name="SettingsPopup"
               PlacementTarget="{Binding ElementName=SettingsHandle}"
               Placement="Top"
               VerticalOffset="-7"
               HorizontalOffset="4"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               StaysOpen="True"
               Closed="OnSettingsPopupClosed">
            <Border x:Name="SettingsPanel"
                    Width="242"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="12"
                    MouseEnter="OnSettingsPanelMouseEnter"
                    MouseLeave="OnSettingsAreaMouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16"
                                      Direction="270"
                                      ShadowDepth="4"
                                      Color="#A0000000"
                                      Opacity=".52"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="显示设置"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,9"/>

                    <TextBlock Text="外观"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9"
                               Margin="0,0,0,4"/>
                    <Border x:Name="ThemeToggle"
                            Width="96"
                            Height="28"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource DividerBrush}"
                            CornerRadius="14"
                            Cursor="Hand"
                            PreviewMouseLeftButtonDown="OnThemeToggleClick">
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ThemeToggleThumb"
                                    Grid.ColumnSpan="2"
                                    Width="44"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    CornerRadius="12"
                                    Background="White">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ThemeToggleTranslate"/>
                                </Border.RenderTransform>
                            </Border>
                            <TextBlock x:Name="LightThemeLabel"
                                       Grid.Column="0"
                                       Text="白"
                                       Foreground="#FF20242B"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="DarkThemeLabel"
                                       Grid.Column="1"
                                       Text="黑"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="背景透明度"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="9"/>
                        <TextBlock x:Name="OpacityValueText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="9"/>
                    </Grid>
                    <Slider x:Name="BackgroundOpacitySlider"
                            Minimum="70"
                            Maximum="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="False"
                            ValueChanged="OnBackgroundOpacityChanged"
                            Margin="0,3,0,0"/>

                    <TextBlock Text="收回气泡"
                               Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9"
                               Margin="0,8,0,4"/>
                    <WrapPanel>
                        <Button Content="10 秒"
                                Tag="10"
                                Style="{StaticResource FlatButtonStyle}"
                                Click="OnArchiveDelayClick"/>
                        <Button Content="15 秒"
                                Tag="15"
                                Style="{StaticResource FlatButtonStyle}"
                                Click="OnArchiveDelayClick"/>
                        <Button Content="30 秒"
                                Tag="30"
                                Style="{StaticResource FlatButtonStyle}"
                                Click="OnArchiveDelayClick"/>
                        <Button Content="1 分"
                                Tag="60"
                                Style="{StaticResource FlatButtonStyle}"
                                Click="OnArchiveDelayClick"/>
                    </WrapPanel>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="{DynamicResource CardBrush}"
                                    Margin="0,0,7,0">
                                <Grid>
                                    <Image x:Name="SettingsAvatarImage" Stretch="UniformToFill"/>
                                    <TextBlock x:Name="SettingsAvatarFallback"
                                               Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="头像"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="10"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="更换…"
                                Style="{StaticResource FlatButtonStyle}"
                                Click="OnChangeAvatarClick"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>

        <Grid x:Name="ArchiveBubbleSurface"
              Visibility="Collapsed"
              Opacity="0"
              Background="Transparent"
              Cursor="Hand"
              MouseEnter="OnBubbleMouseEnter"
              MouseLeave="OnBubbleMouseLeave"
              PreviewMouseLeftButtonDown="OnBubbleMouseDown"
              PreviewMouseLeftButtonUp="OnBubbleMouseUp"
              PreviewMouseMove="OnBubbleMouseMove">
            <Grid Width="56"
                  Height="56"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom">
                <local:AvatarQuotaBubble x:Name="ArchiveBubble"
                                         Width="48"
                                         Height="48"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         RemainingPercent="{Binding WeeklyRemaining}"
                                         Accent="{DynamicResource AccentBrush}"
                                         Track="{DynamicResource DividerBrush}"
                                         BubbleBackground="{DynamicResource CardBrush}"
                                         TextBrush="{DynamicResource TextBrush}"/>
                <Ellipse Width="10"
                         Height="10"
                         Fill="{Binding StatusBrush}"
                         Stroke="{DynamicResource PanelBrush}"
                         StrokeThickness="2"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,5,5,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
